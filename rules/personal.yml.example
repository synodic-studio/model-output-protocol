# Personal overlay — example
#
# Per-user style preferences that are too personal to ship in core. Copy this
# file to `personal.yml` (gitignored locally per deployment) and edit.

rules:

  - name: no-em-dashes
    description: Never use em dashes in prose
    detector: regex
    parameters:
      patterns:
        - "—"
    rationale: |
      Personal style preference. Em dashes feel AI-generated to this user.

  - name: no-staccato-fragments
    description: Avoid clipped Silicon Valley TV-script sentence patterns
    detector: llm
    parameters:
      prompt: |
        Does this message use short clipped fragments and "X is not Y. It's Z."
        patterns that read like a startup-pitch TV script?

  - name: prefer-letters-not-bullets-in-lists
    description: Use letters (a, b, c) for unordered list items the user might cite back
    detector: llm
    rationale: |
      User cites items back by letter ("do b") in voice/chat reply. Plain
      bullets can't be cited shorthand.
