# Copy to scripts/demo.env (gitignored) and fill in.
#
# Only the evaluator matters. The deterministic beats need none of this;
# the three model beats are skipped with a warning if no evaluator answers.
#
# Put literal values here, not `$(pass show ...)` — a GPG pinentry prompt
# in the middle of a demo is a failure mode.

# --- Option 1: a litellm proxy on the presenting machine (no egress needed
# --- beyond whatever the proxy itself talks to).
export MOP_EVALUATOR_MODEL=litellm_proxy/small
export LITELLM_PROXY_API_BASE=http://localhost:4000
export LITELLM_PROXY_API_KEY=sk-...

# --- Option 2: a provider direct. MOP_<PROVIDER>_API_KEY is read as an
# --- isolated key and never exported into any subprocess environment.
# export MOP_EVALUATOR_MODEL=deepseek/deepseek-v4-flash
# export MOP_DEEPSEEK_API_KEY=sk-...

# --- Option 3: anything litellm can reach, including a local model.
# export MOP_EVALUATOR_MODEL=ollama/gemma4:4b
